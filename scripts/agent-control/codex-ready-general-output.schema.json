{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "base_master_sha",
    "changed_paths",
    "workspace_write_confirmed",
    "acceptance_sentinel"
  ],
  "properties": {
    "status": { "const": "PASS" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "base_master_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "workspace_write_confirmed": { "const": true },
    "acceptance_sentinel": { "const": "CODEX_READY_GENERAL_PROOF=PASS" }
  }
}
