{
  "schema_version": 1,
  "max_parallel_projects": 2,
  "shared_path_lock": true,
  "projects": {
    "customer-project-center": {
      "control_issue": 10,
      "task_prefix": "CPC-",
      "branch_prefix": "codex/cpc-",
      "owned_prefixes": [
        "docs/customer-project-center/",
        "src/app/customer-projects/",
        "src/lib/customer-projects/",
        "tests/unit/customer-project-",
        "tests/e2e/customer-project-"
      ],
      "owned_regexes": [
        "^supabase/migrations/[0-9]+_customer_project_center_[A-Za-z0-9_]+\\.sql$"
      ],
      "workflow_file": "customer-project-center-agent-control.yml"
    },
    "global-lead-hub": {
      "control_issue": 72,
      "task_prefix": "GLH-",
      "branch_prefix": "codex/glh-",
      "owned_prefixes": [
        "docs/global-lead-hub/",
        "src/app/global-lead-hub/",
        "src/app/api/global-lead-hub/",
        "src/lib/global-lead-hub/",
        "src/components/global-lead-hub/",
        "tests/unit/global-lead-hub-",
        "tests/e2e/global-lead-hub-"
      ],
      "owned_regexes": [
        "^supabase/migrations/[0-9]+_global_lead_hub_[A-Za-z0-9_]+\\.sql$"
      ],
      "workflow_file": "global-lead-hub-agent-control.yml"
    },
    "workshop-order-system": {
      "control_issue": 104,
      "task_prefix": "WOS-",
      "branch_prefix": "codex/wos-",
      "owned_prefixes": [
        "docs/workshop-order-system/",
        "src/app/workshop-orders/",
        "src/app/api/workshop-orders/",
        "src/lib/workshop-orders/",
        "src/components/workshop-orders/",
        "tests/unit/workshop-order-",
        "tests/e2e/workshop-order-"
      ],
      "owned_regexes": [
        "^supabase/migrations/[0-9]+_workshop_order_system_[A-Za-z0-9_]+\\.sql$"
      ],
      "workflow_file": "workshop-order-system-agent-control.yml"
    }
  },
  "shared_prefixes": [
    ".github/",
    "docs/agent-control/",
    "scripts/agent-control/",
    "src/lib/agent-control/",
    "src/components/layout/",
    "src/lib/supabase/"
  ],
  "shared_exact_paths": [
    "AGENTS.md",
    ".gitignore",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "next.config.mjs",
    "tailwind.config.js",
    "postcss.config.mjs",
    "src/app/layout.tsx",
    "src/middleware.ts"
  ],
  "shared_infrastructure_lane": {
    "project": "agent-control-infrastructure",
    "control_issue": 160,
    "task_prefix": "AC-INFRA-",
    "branch_prefix": "infra/",
    "requires_serialized_shared_path_lock": true,
    "max_active_infrastructure_prs": 1,
    "owned_shared_prefixes": [
      ".github/workflows/",
      "scripts/agent-control/",
      "tests/unit/agent-control-"
    ],
    "owned_shared_exact_paths": [
      ".github/agent-control/project-registry.json"
    ],
    "auto_merge": false,
    "auto_production": false
  }
}
